    {
      "name": "New API usage leads to /api/status",
      "hook": "parseBalance",
      "args": [
        {
          "baseUrl": "https://relay.example.com",
          "credential": null,
          "apiKey": "sk-fixture-key",
          "config": {
            "upstreamKind": "newapi"
          },
          "state": {
            "kind": "newapi",
            "step": 0,
            "probes": null
          }
        },
        {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"code\":true,\"data\":{\"total_available\":2500000,\"unlimited_quota\":false}}"
        }
      ],
      "expected": {
        "next": {
          "method": "GET",
          "path": "/api/status",
          "headers": {
            "Authorization": "Bearer sk-fixture-key",
            "Accept": "application/json"
          }
        },
        "state": {
          "kind": "newapi",
          "step": 1,
          "probes": null,
          "quota": 2500000
        }
      }
    },
    {
      "name": "New API quota converts with quota_per_unit",
      "hook": "parseBalance",
      "args": [
        {
          "baseUrl": "https://relay.example.com",
          "credential": null,
          "apiKey": "sk-fixture-key",
          "config": {
            "upstreamKind": "newapi"
          },
          "state": {
            "kind": "newapi",
