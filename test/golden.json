        },
        {
          "status": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "{\"data\":{\"quota_per_unit\":500000}}"
        }
      ],
      "expected": {
        "amount": 5,
        "currency": "USD"
      }
    },
