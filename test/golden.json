    {
      "name": "below the threshold disables",
      "hook": "decide",
      "args": [
        {
          "disableBelow": 5,
          "enableAtOrAbove": 10,
          "autoDisable": true,
          "reenable": "balance"
        },
        "enabled",
        null,
        {
          "amount": 4,
          "currency": "USD"
        }
      ],
      "expected": {
        "keyStatus": "auto_disabled",
        "notify": {
          "en": "Upstream balance 4 USD is below the threshold 5 USD; key disabled",
          "zh": "上游余额 4 USD 低于阈值 5 USD，已禁用该密钥"
        }
      }
    },
    {
      "name": "recovered balance re-enables a low-balance key",
      "hook": "decide",
      "args": [
        {
          "disableBelow": 5,
          "enableAtOrAbove": 10,
          "autoDisable": true,
          "reenable": "balance"
        },
        "auto_disabled",
        "Insufficient balance",
        {
          "amount": 10,
          "currency": "USD"
        }
      ],
      "expected": {
        "keyStatus": "enabled",
        "notify": {
          "en": "Upstream balance recovered to 10 USD; key enabled again",
          "zh": "上游余额已恢复到 10 USD，已重新启用该密钥"
        }
      }
    },
