  "cases": [
    {
      "name": "DeepSeek host is detected and queried with the key",
      "hook": "buildBalanceRequest",
      "args": [
        {
          "baseUrl": "https://api.deepseek.com",
          "credential": null,
          "apiKey": "sk-fixture-key",
          "config": {},
          "state": null
