      ],
      "expected": {
        "method": "GET",
        "path": "/user/balance",
        "headers": {
          "Authorization": "Bearer sk-fixture-key",
          "Accept": "application/json"
        },
        "state": {
          "kind": "deepseek",
          "step": 0,
          "probes": null
        }
      }
    },
    {
